/.gradle/
/app/build/
/app/src/
/gradle/

# Android TWA project (generated under android/ so it does not clash with Next.js app/)
android/.gradle/
android/.idea/
android/local.properties
android/app/build/
android/build/
android/*.apk
android/*.aab
android/*.idsig
android/*.keystore
android/*.jks

